# HACKMINT Configuration File Example

# Pretrained Plant Disease Model (Hugging Face Hub)
HACKMINT_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# OpenCV Laplacian Blur Threshold (Variance of Laplacian)
# Values below this threshold are rejected by the Image Quality Gate
HACKMINT_BLUR_THRESHOLD=100.0

# Force Mock / Demo Mode (Set to true to demonstrate marked synthetic fallback)
HACKMINT_FORCE_MOCK=false

# Optional External LLM Integration (If configured, used only for plain-language explanation)
# System works 100% offline and locally without any API key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
